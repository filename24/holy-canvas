{
	"name": "holy-canvas",
	"version": "1.0.0",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/filename24/holy-canvas.git"
	},
	"bugs": {
		"url": "https://github.com/filename24/holy-canvas/issues"
	},
	"homepage": "https://github.com/filename24/holy-canvas#readme",
	"bin": {
		"holy-canvas": "dist/cli.js",
		"hcvs": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsc",
		"build:bun": "bun run scripts/build.ts",
		"compile": "bun run scripts/build.ts --compile",
		"dev": "tsc --watch",
		"package": "bash scripts/package-release.sh",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"chalk": "^5.6.2",
		"commander": "^15.0.0",
		"conf": "^15.1.0",
		"ink": "^4.4.1",
		"ink-text-input": "^6.0.0",
		"react": "^18.3.1",
		"react-devtools-core": "^8.0.0",
		"yoga-wasm-web": "^0.3.3"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/react": "^18.3.31",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.3.1",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.8",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"ignores": [
			"scripts/**"
		],
		"rules": {
			"react/prop-types": "off",
			"unicorn/expiring-todo-comments": "off",
			"unicorn/prevent-abbreviations": "off",
			"@typescript-eslint/naming-convention": "off",
			"no-await-in-loop": "off",
			"@typescript-eslint/consistent-type-definitions": "off",
			"react/prefer-read-only-props": "off",
			"react/jsx-sort-props": "off",
			"@typescript-eslint/ban-types": "off",
			"import/order": "off",
			"n/prefer-global/buffer": "off",
			"max-params": "off",
			"unicorn/catch-error-name": "off",
			"unicorn/prefer-export-from": "off",
			"@typescript-eslint/promise-function-async": "off",
			"react/boolean-prop-naming": "off",
			"@typescript-eslint/no-unsafe-assignment": "off",
			"n/prefer-global/process": "off",
			"@typescript-eslint/no-implicit-any-catch": "off",
			"react/no-array-index-key": "off",
			"no-negated-condition": "off",
			"max-depth": "off",
			"no-constant-condition": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
